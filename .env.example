# Copy to .env and fill in your values

# Supabase credentials (from your Supabase project settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Frontend origins allowed to call this API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://myofficefrontend.vercel.app

# Redis connection (used for response caching — see app/cache.py)
REDIS_URL=redis://localhost:6379/0

# Per-IP request cap applied to every endpoint (see app/rate_limit.py). Optional —
# defaults to 300/minute if unset.
RATE_LIMIT_DEFAULT=300/minute

# Sentry error tracking (optional). Leave unset to disable entirely — nothing breaks,
# errors just aren't reported anywhere. Get a DSN from a project at sentry.io.
SENTRY_DSN=
